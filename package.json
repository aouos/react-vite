{
  "name": "react-vite",
  "version": "0.1.0",
  "description": "Interactive React + Vite project scaffolding with optional TypeScript, Tailwind CSS, React Router, ESLint + Prettier, and Zustand.",
  "type": "module",
  "bin": {
    "rv": "bin/rv.js",
    "react-vite": "bin/rv.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "smoke": "node ./scripts/smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "verify:release": "npm run typecheck && npm test && npm run smoke && npm run pack:check",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltguo/react-vite.git"
  },
  "bugs": {
    "url": "https://github.com/boltguo/react-vite/issues"
  },
  "homepage": "https://github.com/boltguo/react-vite#readme",
  "keywords": [
    "react",
    "vite",
    "cli",
    "scaffold",
    "typescript",
    "tailwindcss",
    "react-router",
    "zustand"
  ],
  "author": "boltguo",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "commander": "14.0.3",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "6.0.3"
  }
}
